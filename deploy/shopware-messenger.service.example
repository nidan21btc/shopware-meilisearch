# EXAMPLE ONLY: adapt identity, paths, transports and limits to the installation.
# This consumer executes other Shopware messages too; reuse existing workers.
[Unit]
Description=Shopware messenger consumer
After=network.target

[Service]
Type=simple
User=shopware
Group=shopware
WorkingDirectory=/srv/shopware/current
Environment=APP_ENV=prod
Environment=APP_DEBUG=0
ExecStart=/usr/bin/php -d memory_limit=384M bin/console messenger:consume async low_priority --time-limit=300 --memory-limit=384M
Restart=always
RestartSec=5
TimeoutStopSec=1800
MemoryMax=512M
UMask=0022
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
